# 配置文件路径（支持绝对路径或相对项目根目录）
SMARTBUILDING_CONFIG_PATH=config.yaml

# 日志目录
SMARTBUILDING_LOG_DIR=logs

# RDF 资源目录
SMARTBUILDING_RDF_DIR=resources/rdf

# PostgreSQL（本地或服务器地址）
DB_TYPE=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_NAME=SmartBuilding
DB_PASSWORD=123456

# Redis（后端运行必需，本地或服务器地址）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=123456

# 数据库结构升级应使用 alembic upgrade head；不建议启动时自动建表。
AUTO_CREATE_TABLES=false

# 如果服务器使用了自定义值，本地连接服务器数据时应填写相同的值。
# SMARTBUILDING_JWT_SECRET=
# SMARTBUILDING_FERNET_KEY=

